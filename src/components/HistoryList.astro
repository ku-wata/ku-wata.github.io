---
import { formatDateRange } from "../lib/researchmap";

export interface HistoryItem {
  from: string;
  to: string;
  title: string;
  subtitle?: string;
  detail?: string;
}

interface Props {
  items: HistoryItem[];
}

const { items } = Astro.props;
---

<div class="history-list">
  {items.map((item) => (
    <div class="history-row">
      <div class="history-period">{formatDateRange(item.from, item.to)}</div>
      <div class="history-info">
        <span class="history-title">{item.title}</span>
        {item.subtitle && <span class="history-subtitle"> {item.subtitle}</span>}
        {item.detail && <span class="history-detail"> ({item.detail})</span>}
      </div>
    </div>
  ))}
</div>

<style>
  .history-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    width: 100%;
  }

  .history-row {
    display: grid;
    grid-template-columns: 165px 1fr;
    gap: 1rem;
    align-items: baseline;
    font-size: 0.92rem;
    line-height: 1.6;
  }

  @media (max-width: 580px) {
    .history-row {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }
  }

  .history-period {
    font-size: 0.85rem;
    color: var(--color-text-subtle);
    font-variant-numeric: tabular-nums;
  }

  .history-info {
    color: var(--color-text-main);
  }

  .history-title {
    font-weight: 500;
  }

  .history-subtitle {
    color: var(--color-text-muted);
  }

  .history-detail {
    color: var(--color-text-subtle);
  }
</style>
