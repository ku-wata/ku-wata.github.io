---
import type { Profile } from "../data/profile";

interface Props {
  profile: Profile;
  degree?: string;
}

const { profile, degree } = Astro.props;
---

<section class="profile-section">
  <div class="profile-avatar-wrapper">
    <img src={profile.avatar} alt={profile.name.en} class="profile-avatar" />
  </div>
  <div class="profile-details">
    <div class="name-block">
      <h1 class="profile-name">
        {profile.name.ja}
        <span class="name-en">{profile.name.en}</span>
      </h1>
      <p class="profile-title">{profile.title}</p>
    </div>

    <div class="affiliation-block">
      <p class="affil-ja">{profile.affiliation.ja}</p>
      <p class="affil-en">{profile.affiliation.en}</p>
      {profile.laboratory && (
        <p class="affil-lab">
          研究室: <a href={profile.laboratory.url} target="_blank" rel="noopener noreferrer">{profile.laboratory.name}</a>
        </p>
      )}
      {degree && <p class="affil-degree">学位: {degree}</p>}
    </div>

    {profile.bio && <p class="profile-bio">{profile.bio}</p>}

    <div class="profile-links">
      {profile.links.map((link) => (
        <a href={link.url} target="_blank" rel="noopener noreferrer" class="link-btn">
          <span>{link.label} ↗</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .profile-section {
    width: 100%;
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    padding-bottom: 2rem;
    border-bottom: 1.5px solid var(--color-border);
  }

  @media (max-width: 600px) {
    .profile-section {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1.25rem;
    }
  }

  .profile-avatar-wrapper {
    flex-shrink: 0;
  }

  .profile-avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    background-color: var(--color-badge-bg);
    border: 2px solid var(--color-border);
  }

  .profile-details {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    flex: 1;
  }

  .name-block {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .profile-name {
    font-size: 1.65rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-text-main);
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  @media (max-width: 600px) {
    .profile-name {
      justify-content: center;
    }
  }

  .name-en {
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--color-text-subtle);
  }

  .profile-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .affiliation-block {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .affil-ja {
    font-weight: 500;
    color: var(--color-text-main);
  }

  .affil-en {
    font-size: 0.85rem;
    color: var(--color-text-subtle);
  }

  .affil-lab,
  .affil-degree {
    font-size: 0.88rem;
    margin-top: 0.15rem;
  }

  .profile-bio {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .profile-links {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.2rem;
  }

  @media (max-width: 600px) {
    .profile-links {
      justify-content: center;
    }
  }

  .link-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.65rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-badge-text);
    background-color: var(--color-badge-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    transition: all 0.15s ease;
  }

  .link-btn:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
    text-decoration: none;
  }
</style>
