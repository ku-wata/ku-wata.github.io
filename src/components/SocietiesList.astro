---
import type { Society } from "../lib/researchmap";
import { formatDateRange } from "../lib/researchmap";

interface Props {
  societies: Society[];
}

const { societies } = Astro.props;
---

<div class="societies-list">
  {societies.map((society) => (
    <div class="society-row">
      <div class="society-period">{formatDateRange(society.from, society.to)}</div>
      <div class="society-name">{society.name}</div>
    </div>
  ))}
</div>

<style>
  .societies-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
  }

  .society-row {
    display: grid;
    grid-template-columns: 165px 1fr;
    gap: 1rem;
    align-items: baseline;
    font-size: 0.92rem;
    line-height: 1.6;
  }

  @media (max-width: 580px) {
    .society-row {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }
  }

  .society-period {
    font-size: 0.85rem;
    color: var(--color-text-subtle);
    font-variant-numeric: tabular-nums;
  }

  .society-name {
    color: var(--color-text-main);
    font-weight: 500;
  }
</style>
