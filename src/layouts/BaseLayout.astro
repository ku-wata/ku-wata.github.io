---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import type { Profile } from "../data/profile";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  profile: Profile;
}

const { profile } = Astro.props;
const title = Astro.props.title ?? `${profile.name.ja} (${profile.name.en}) | Profile`;
const description =
  Astro.props.description ??
  `${profile.name.ja} (${profile.name.en}) - ${profile.affiliation.ja} ${profile.title} の個人サイトです。`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Header name={profile.name.en} />

    <main class="main-container">
      <slot />
    </main>

    <Footer nameJa={profile.name.ja} nameEn={profile.name.en} />
  </body>
</html>

<style>
  .main-container {
    max-width: var(--max-width);
    width: 100%;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
</style>
