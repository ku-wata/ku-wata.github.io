---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProfileCard from "../components/ProfileCard.astro";
import SectionCard from "../components/SectionCard.astro";
import HistoryList from "../components/HistoryList.astro";
import PublicationsList from "../components/PublicationsList.astro";
import MiscList from "../components/MiscList.astro";
import SocietiesList from "../components/SocietiesList.astro";
import { profile } from "../data/profile";
import { getResearchmapData } from "../lib/researchmap";

const rmData = getResearchmapData();

// 学歴データの変換
const educationItems = rmData.education.map((edu) => ({
  from: edu.from,
  to: edu.to,
  title: edu.institution,
  subtitle: [edu.department, edu.course].filter(Boolean).join(" "),
}));

// 経歴データの変換
const experienceItems = rmData.researchExperience.map((exp) => ({
  from: exp.from,
  to: exp.to,
  title: [exp.affiliation, exp.section].filter(Boolean).join(" "),
  subtitle: exp.job,
}));
---

<BaseLayout profile={profile}>
  {/* 基本情報 プロフィール */}
  <ProfileCard profile={profile} degree={rmData.degree} />

  {/* 学歴 */}
  {educationItems.length > 0 && (
    <SectionCard title="学歴" enTitle="Education">
      <HistoryList items={educationItems} />
    </SectionCard>
  )}

  {/* 経歴 */}
  {experienceItems.length > 0 && (
    <SectionCard title="経歴" enTitle="Experience">
      <HistoryList items={experienceItems} />
    </SectionCard>
  )}

  {/* 論文 */}
  {rmData.papers.length > 0 && (
    <SectionCard title="論文" enTitle="Publications">
      <PublicationsList papers={rmData.papers} />
    </SectionCard>
  )}

  {/* MISC */}
  {rmData.misc.length > 0 && (
    <SectionCard title="MISC / 発表" enTitle="MISC & Presentations">
      <MiscList misc={rmData.misc} />
    </SectionCard>
  )}

  {/* 所属学協会 */}
  {rmData.societies.length > 0 && (
    <SectionCard title="所属学協会" enTitle="Affiliated Societies">
      <SocietiesList societies={rmData.societies} />
    </SectionCard>
  )}
</BaseLayout>
